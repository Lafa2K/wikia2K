# Copie este arquivo para ".env" e preencha com os dados do SEU projeto Supabase.
# Não coloque valores reais aqui — este arquivo é o que fica público no GitHub.
#
# Onde encontrar: painel do Supabase > Project Settings > API.

# Usadas no servidor (SSR / server functions)
SUPABASE_PROJECT_ID=""
SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# Mesmas informações, expostas ao navegador (prefixo VITE_ obrigatório).
# Nunca coloque a SERVICE_ROLE_KEY aqui com prefixo VITE_ — ela ignora as regras
# de segurança (RLS) e não pode nunca chegar ao navegador do usuário.
VITE_SUPABASE_PROJECT_ID=""
VITE_SUPABASE_PUBLISHABLE_KEY=""
VITE_SUPABASE_URL=""
